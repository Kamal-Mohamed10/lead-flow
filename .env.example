# Supabase (required for Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (server-side address autocomplete for Phase 2)
MAPBOX_ACCESS_TOKEN=
# Optional public token for a future browser map; do not use it for server secrets.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI seller research (optional; a transparent rules-based summary is used without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Property enrichment (optional; local summaries are used without a key)
SCHOOL_API_KEY=
SCHOOL_API_BASE_URL=

# Reserved for later phases
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
